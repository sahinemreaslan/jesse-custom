# Exchange API Configuration
# Copy this file to .env and fill in your actual values

# Binance API (Example)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_TESTNET=true  # true for testnet, false for production

# Database Configuration
DATABASE_TYPE=sqlite  # sqlite or influxdb
DATABASE_PATH=data/historical/trading.db

# InfluxDB Configuration (if using)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your_influxdb_token
INFLUXDB_ORG=your_org
INFLUXDB_BUCKET=trading_data

# Trading Configuration
DEFAULT_SYMBOL=BTC/USDT
DEFAULT_TIMEFRAME=1h
INITIAL_CAPITAL=10000
COMMISSION_PCT=0.1  # 0.1%

# Risk Management
MAX_POSITION_SIZE=0.1  # 10% of capital per trade
MAX_DAILY_LOSS=0.05     # 5% max daily loss
STOP_LOSS_PCT=0.02      # 2% stop loss
TAKE_PROFIT_PCT=0.04    # 4% take profit

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_TO_FILE=true
LOG_FILE_PATH=logs/trading.log

# Optimization Settings
USE_MULTIPROCESSING=true
NUM_WORKERS=4  # -1 for all CPU cores
